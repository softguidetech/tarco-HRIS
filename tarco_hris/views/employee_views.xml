<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_tarco_hris" model="ir.ui.view">
        <field name="name">hr.employee.form.tarco.hris</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tarco_give_custody" type="object" string="Give custody" groups="hr.group_hr_user" class="btn-primary" invisible="tarco_resignation_date"/>
                <button name="action_tarco_eos" type="object" string="End of service" groups="hr.group_hr_user" class="btn-primary"/>
                <button name="action_tarco_resign" type="object" string="Register resignation" groups="hr.group_hr_user" invisible="tarco_resignation_date"/>
                <button name="action_tarco_fire" type="object" string="Register dismissal" groups="hr.group_hr_user" invisible="tarco_resignation_date"/>
                <button name="action_tarco_rehire" type="object" string="Rehire" groups="hr.group_hr_user" invisible="not tarco_resignation_date"/>
                <button name="action_tarco_renew" type="object" string="Renew contract" groups="hr.group_hr_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_tarco_open_documents" type="object" class="oe_stat_button" icon="fa-folder-open" groups="hr.group_hr_user">
                    <field name="tarco_document_count" widget="statinfo" string="Documents"/>
                </button>
                <button name="action_tarco_open_missions" type="object" class="oe_stat_button" icon="fa-plane" groups="hr.group_hr_user">
                    <field name="tarco_mission_count" widget="statinfo" string="Missions"/>
                </button>
                <button name="action_tarco_open_penalties" type="object" class="oe_stat_button" icon="fa-gavel" groups="hr.group_hr_user">
                    <field name="tarco_penalty_count" widget="statinfo" string="Penalties"/>
                </button>
                <button name="action_tarco_open_rewards" type="object" class="oe_stat_button" icon="fa-gift" groups="hr.group_hr_user">
                    <field name="tarco_reward_count" widget="statinfo" string="Rewards"/>
                </button>
                <button name="action_tarco_open_advances" type="object" class="oe_stat_button" icon="fa-money" groups="hr.group_hr_user">
                    <field name="tarco_advance_count" widget="statinfo" string="Advances"/>
                </button>
                <button name="action_tarco_open_encashment" type="object" class="oe_stat_button" icon="fa-calendar" groups="hr.group_hr_user">
                    <field name="tarco_encashment_count" widget="statinfo" string="Encashment"/>
                </button>
                <button name="action_tarco_open_kpi" type="object" class="oe_stat_button" icon="fa-line-chart" groups="hr.group_hr_user">
                    <field name="tarco_kpi_count" widget="statinfo" string="KPIs"/>
                </button>
                <button name="action_tarco_open_requirements" type="object" class="oe_stat_button" icon="fa-check-square-o" groups="hr.group_hr_user">
                    <field name="tarco_requirement_todo_count" widget="statinfo" string="Work to do"/>
                </button>
                <button name="action_tarco_open_assets" type="object" class="oe_stat_button" icon="fa-laptop" groups="hr.group_hr_user">
                    <field name="tarco_asset_outstanding_count" widget="statinfo" string="Custody out"/>
                </button>
                <button name="action_tarco_open_eos" type="object" class="oe_stat_button" icon="fa-sign-out" groups="hr.group_hr_user">
                    <field name="tarco_eos_count" widget="statinfo" string="End of service"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='hr_settings']" position="before">
                <page name="tarco_hr_file" string="HR File" groups="hr.group_hr_user">
                    <group>
                        <group string="Identity">
                            <field name="employee_code" placeholder="Generated on save from the joining month"/>
                            <field name="department_id"/>
                            <field name="section_id"/>
                            <field name="job_id"/>
                            <field name="parent_id"/>
                            <field name="tarco_hire_date"/>
                            <field name="birthday"/>
                            <field name="country_id"/>
                            <field name="sex"/>
                            <field name="marital"/>
                            <field name="tarco_religion"/>
                            <field name="certificate"/>
                            <field name="study_field"/>
                            <field name="study_school"/>
                            <field name="tarco_experience_years"/>
                        </group>
                        <group string="Contact and address">
                            <field name="private_phone"/>
                            <field name="mobile_phone"/>
                            <field name="emergency_phone"/>
                            <field name="private_email"/>
                            <field name="work_email"/>
                            <field name="tarco_state_id"/>
                            <field name="tarco_city"/>
                            <field name="tarco_district"/>
                            <field name="tarco_square"/>
                        </group>
                    </group>
                    <group string="Contract">
                        <group>
                            <field name="tarco_trial_date_end"/>
                            <field name="tarco_payroll_trial_end"/>
                            <field name="tarco_trial_manual"/>
                            <field name="tarco_contract_date_end"/>
                            <field name="tarco_renewal_date"/>
                            <field name="tarco_renewal_manual"/>
                            <field name="tarco_due_kind"/>
                            <field name="tarco_service_display"/>
                        </group>
                        <group>
                            <field name="tarco_resignation_date"/>
                            <field name="tarco_rehire_date"/>
                            <field name="tarco_shift_id"/>
                            <field name="tarco_exempt_late"/>
                            <field name="tarco_overtime_mode"/>
                        </group>
                    </group>
                    <group string="Salary">
                        <field name="currency_id" invisible="1"/>
                        <field name="tarco_basic_wage"/>
                        <field name="tarco_cola"/>
                        <field name="tarco_transport_allowance"/>
                        <field name="tarco_housing_allowance"/>
                        <field name="tarco_other_allowance"/>
                        <field name="tarco_gross_wage"/>
                        <field name="tarco_subject_to_tax"/>
                        <field name="tarco_tax_rate" invisible="not tarco_subject_to_tax"/>
                        <field name="tarco_subject_to_insurance"/>
                        <field name="tarco_insurance_rate" invisible="not tarco_subject_to_insurance"/>
                        <field name="tarco_auto_statutory" invisible="not tarco_subject_to_tax and not tarco_subject_to_insurance"/>
                        <field name="tarco_statutory_month" invisible="not tarco_statutory_month"/>
                    </group>
                    <group string="Leave balance">
                        <field name="tarco_leave_scheme"/>
                        <field name="tarco_casual_days"/>
                        <field name="tarco_regular_days"/>
                    </group>
                    <group string="Leave encashment on this month's payroll">
                        <group>
                            <field name="tarco_encashment_month_days"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="tarco_encashment_month_amount"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                Confirmed sold leave in this calendar month. The amount is posted as a salary
                                adjustment (Tarco Earning) and is paid extra on this month's payslip.
                            </div>
                        </group>
                    </group>
                    <group string="Leave encashment records">
                        <field name="tarco_encashment_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="name"/>
                                <field name="encash_date"/>
                                <field name="days"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="amount"/>
                                <field name="state"/>
                                <field name="salary_attachment_id" optional="show" string="Salary adjustment"/>
                            </list>
                        </field>
                    </group>
                    <div>
                        <button name="action_tarco_apply_leave_scheme" type="object" string="Apply leave scheme" class="btn-secondary"/>
                        <button name="action_tarco_post_statutory" type="object" string="Post tax and insurance" class="btn-secondary"
                                invisible="tarco_auto_statutory or (not tarco_subject_to_tax and not tarco_subject_to_insurance)"/>
                        <button name="action_tarco_onboarding" type="object" string="Onboarding notice" class="btn-secondary"/>
                        <button name="action_tarco_give_custody" type="object" string="Give custody" class="btn-primary"
                                invisible="tarco_resignation_date"/>
                        <button name="action_tarco_employee_report" type="object" string="Print file" class="btn-primary"/>
                    </div>
                    <group string="Work requirements after hiring">
                        <field name="tarco_requirement_ids" nolabel="1" colspan="2">
                            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'" decoration-warning="state == 'todo'">
                                <field name="name"/>
                                <field name="kind"/>
                                <field name="state"/>
                                <field name="done_date" optional="show"/>
                                <field name="asset_id" optional="show"/>
                                <button name="action_done" type="object" string="Done" icon="fa-check"
                                        invisible="state != 'todo'"/>
                                <button name="action_issue_custody" type="object" string="Issue custody" icon="fa-laptop"
                                        invisible="state != 'todo' or kind not in ('computer', 'mobile', 'uniform', 'badge', 'warehouse', 'other')"/>
                            </list>
                        </field>
                    </group>
                    <group string="Employee custody">
                        <field name="tarco_asset_ids" nolabel="1" colspan="2" context="{'default_state': 'issued'}">
                            <list create="false" delete="false" decoration-info="state == 'issued'" decoration-success="state == 'returned'" decoration-danger="state == 'lost'">
                                <field name="name" optional="hide" readonly="1"/>
                                <field name="type_id" readonly="1"/>
                                <field name="description" readonly="1"/>
                                <field name="serial" readonly="1"/>
                                <field name="quantity" optional="hide" readonly="1"/>
                                <field name="issue_date" readonly="1"/>
                                <field name="return_date" optional="show" readonly="1"/>
                                <field name="state" readonly="1"/>
                                <button name="action_return" type="object" string="Return" icon="fa-undo"
                                        invisible="state != 'issued'"/>
                                <button name="action_lost" type="object" string="Lost" icon="fa-times-circle"
                                        invisible="state != 'issued'"
                                        confirm="Mark this item as lost? It will not be expected back at end of service."/>
                            </list>
                        </field>
                    </group>
                    <group string="Hiring and audit documents">
                        <field name="tarco_document_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="group_type"/>
                                <field name="kind"/>
                                <field name="received"/>
                                <field name="document_date"/>
                                <field name="datas" filename="datas_fname" widget="binary"/>
                                <field name="datas_fname" column_invisible="1"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_hierarchy_tarco" model="ir.ui.view">
        <field name="name">hr.employee.hierarchy.tarco.full</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_org_chart.hr_employee_hierarchy_view"/>
        <field name="arch" type="xml">
            <xpath expr="//hierarchy" position="attributes">
                <attribute name="js_class">tarco_hr_employee_hierarchy</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_hr_department_hierarchy_tarco" model="ir.ui.view">
        <field name="name">hr.department.hierarchy.tarco.full</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr_org_chart.hr_department_hierarchy_view"/>
        <field name="arch" type="xml">
            <xpath expr="//hierarchy" position="attributes">
                <attribute name="js_class">tarco_full_hierarchy</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_employee_tree_tarco_hris" model="ir.ui.view">
        <field name="name">hr.employee.list.tarco.hris</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_tarco_apply_leave_scheme" type="object" string="Apply leave scheme"
                            class="btn-secondary" groups="hr.group_hr_user"
                            confirm="Create this year's casual and annual leave allocations for the selected employees?"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="employee_code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="parent_id" optional="show" string="Manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_filter_tarco_hris" model="ir.ui.view">
        <field name="name">hr.employee.search.tarco.hris</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', ('employee_code', 'ilike', self), ('work_email', 'ilike', self), ('name', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_code"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Probation ending (10 days)" name="probation_due" domain="[('tarco_due_kind', '=', 'probation')]"/>
                <filter string="Contract expiry (10 days)" name="renewal_due" domain="[('tarco_due_kind', '=', 'renewal')]"/>
                <filter string="Resigned" name="resigned" domain="[('tarco_resignation_date', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_contract_list" model="ir.ui.view">
        <field name="name">hr.employee.contract.list.tarco</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_tarco_apply_leave_scheme" type="object" string="Apply leave scheme"
                            class="btn-secondary" groups="hr.group_hr_user"
                            confirm="Create this year's casual and annual leave allocations for the selected employees?"/>
                </header>
                <field name="employee_code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="section_id"/>
                <field name="job_id"/>
                <field name="tarco_hire_date"/>
                <field name="tarco_payroll_trial_end"/>
                <field name="tarco_trial_date_end" optional="hide"/>
                <field name="tarco_contract_date_end"/>
                <field name="tarco_renewal_date" optional="hide"/>
                <field name="tarco_due_kind"/>
                <field name="tarco_resignation_date"/>
                <field name="tarco_rehire_date"/>
                <field name="tarco_service_display"/>
                <field name="tarco_gross_wage"/>
            </list>
        </field>
    </record>

    <record id="action_server_tarco_apply_leave_scheme" model="ir.actions.server">
        <field name="name">Apply leave scheme</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_tarco_apply_leave_scheme()</field>
    </record>
    <record id="action_server_tarco_generate_code" model="ir.actions.server">
        <field name="name">Generate employee code</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_tarco_generate_code()</field>
    </record>
</odoo>
