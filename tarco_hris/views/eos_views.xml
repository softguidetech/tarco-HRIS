<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tarco_eos_form" model="ir.ui.view">
        <field name="name">tarco.hr.eos.form</field>
        <field name="model">tarco.hr.eos</field>
        <field name="arch" type="xml">
            <form string="End of service">
                <header>
                    <button name="action_send_to_finance" type="object" string="Send to finance" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Mark paid"
                            invisible="state != 'to_pay'"/>
                    <button name="action_print" type="object" string="Print"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'to_pay')"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_pay,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_salary_attachment" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="not salary_attachment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payroll</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="employee_code"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="hire_date"/>
                            <field name="last_working_day" readonly="state != 'draft'"/>
                            <field name="exit_kind" readonly="state != 'draft'"/>
                            <field name="misconduct" invisible="exit_kind != 'fired'" readonly="state != 'draft'"/>
                            <field name="record_exit" readonly="state != 'draft'"/>
                            <field name="custody_outstanding_count"/>
                        </group>
                        <group string="Amount for finance">
                            <field name="amount_mode" widget="radio" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="wage_base" readonly="state != 'draft'"/>
                            <field name="service_display"/>
                            <field name="first_band_years"/>
                            <field name="first_band_amount"/>
                            <field name="extra_years"/>
                            <field name="extra_amount"/>
                            <field name="calculated_amount"/>
                            <field name="formula_note"/>
                            <field name="fixed_amount" invisible="amount_mode != 'fixed'" required="amount_mode == 'fixed'"
                                   readonly="state != 'draft'"/>
                            <field name="amount" readonly="1"/>
                            <field name="salary_attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Note for finance"/>
                    </group>
                    <p class="text-muted">
                        Calculate uses Sudan Labour Act 1997: half a month of the last wage for each of the first five years,
                        then one month for each year after that. Or choose Fixed amount and type what finance should pay.
                        Send to finance posts a Tarco Earning on the next payslip.
                    </p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_tarco_eos_list" model="ir.ui.view">
        <field name="name">tarco.hr.eos.list</field>
        <field name="model">tarco.hr.eos</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'to_pay'" decoration-success="state == 'paid'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="employee_code" optional="show"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="exit_kind"/>
                <field name="last_working_day"/>
                <field name="amount_mode" optional="hide"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_tarco_eos_search" model="ir.ui.view">
        <field name="name">tarco.hr.eos.search</field>
        <field name="model">tarco.hr.eos</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="to_pay" string="Sent to finance" domain="[('state', '=', 'to_pay')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_kind" string="Reason" context="{'group_by': 'exit_kind'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_tarco_eos" model="ir.actions.act_window">
        <field name="name">End of service</field>
        <field name="res_model">tarco.hr.eos</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_pay': 1}</field>
    </record>
</odoo>
