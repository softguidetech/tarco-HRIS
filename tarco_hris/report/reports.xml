<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_employee_file" model="ir.actions.report">
        <field name="name">Employee File</field>
        <field name="model">tarco.hr.employee.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tarco_hris.report_employee_file</field>
        <field name="report_file">tarco_hris.report_employee_file</field>
        <field name="print_report_name">'Employee File - %s' % (object.employee_id.name)</field>
    </record>
    <record id="action_report_period" model="ir.actions.report">
        <field name="name">Tarco HR Report</field>
        <field name="model">tarco.hr.period.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tarco_hris.report_tarco_period</field>
        <field name="report_file">tarco_hris.report_tarco_period</field>
        <field name="print_report_name">'Tarco HR - %s' % (object.report_type)</field>
    </record>

    <record id="action_report_mission" model="ir.actions.report">
        <field name="name">Mission Order</field>
        <field name="model">tarco.hr.mission</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tarco_hris.report_mission</field>
        <field name="report_file">tarco_hris.report_mission</field>
        <field name="print_report_name">'Mission - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_tarco_hr_mission"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mission_document">
        <t t-call="web.external_layout">
            <t t-set="cur" t-value="o.currency_id"/>
            <div class="page">
                <div class="d-flex justify-content-between align-items-end mb-3">
                    <div>
                        <h2 class="mb-0">Mission Order / أمر مأمورية</h2>
                        <div class="text-muted">Reference <strong t-out="o.name"/></div>
                    </div>
                    <div class="text-end">
                        <span class="badge text-bg-secondary fs-6" t-field="o.state"/>
                    </div>
                </div>

                <table class="table table-sm table-bordered mb-3">
                    <tr>
                        <th class="w-25 table-light">Place / المكان</th><td t-out="o.place"/>
                        <th class="w-25 table-light">Currency / العملة</th><td><t t-out="cur.name"/> (<t t-out="cur.symbol"/>)</td>
                    </tr>
                    <tr>
                        <th class="table-light">From / من</th><td><span t-field="o.date_start"/> <span t-field="o.hour_start" t-options="{'widget': 'float_time'}"/></td>
                        <th class="table-light">To / إلى</th><td><span t-field="o.date_end"/> <span t-field="o.hour_end" t-options="{'widget': 'float_time'}"/></td>
                    </tr>
                    <tr>
                        <th class="table-light">Days / الأيام</th><td t-out="o.number_of_days"/>
                        <th class="table-light">Employees / الموظفون</th><td t-out="o.employee_count"/>
                    </tr>
                    <tr>
                        <th class="table-light">Cost per person per day</th>
                        <td><span t-field="o.per_diem" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                        <th class="table-light">Total hours</th><td t-out="'%.2f' % o.total_hours"/>
                    </tr>
                </table>

                <h5>Purpose / الغرض</h5>
                <p t-field="o.purpose" class="mb-3"/>

                <h5>Employees / الموظفون</h5>
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>#</th><th>Code</th><th>Name</th><th>Department</th><th>Job</th>
                            <th class="text-end">Days</th><th class="text-end">Amount (<t t-out="cur.name"/>)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td t-out="line_index + 1"/>
                            <td t-out="line.employee_code or ''"/>
                            <td t-out="line.employee_id.name"/>
                            <td t-out="line.department_id.name or ''"/>
                            <td t-out="line.job_id.name or ''"/>
                            <td class="text-end" t-out="o.number_of_days"/>
                            <td class="text-end"><span t-field="line.amount" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="6" class="text-end">Total / الإجمالي</td>
                            <td class="text-end"><span t-field="o.cost" t-options="{'widget': 'monetary', 'display_currency': cur}"/></td>
                        </tr>
                        <tr t-if="cur != o.company_currency_id" class="text-muted">
                            <td colspan="6" class="text-end">Equivalent in <t t-out="o.company_currency_id.name"/> at the rate of <span t-field="o.date_start"/></td>
                            <td class="text-end"><span t-field="o.cost_company_currency" t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/></td>
                        </tr>
                    </tfoot>
                </table>

                <table class="table table-borderless mt-5 text-center">
                    <tr>
                        <td class="w-33">Requested by / مقدم الطلب<br/><br/>____________________</td>
                        <td class="w-33">Human Resources / الموارد البشرية<br/><br/>____________________</td>
                        <td class="w-33">Approved by / الاعتماد<br/><br/>____________________</td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_mission">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="tarco_hris.report_mission_document"/>
            </t>
        </t>
    </template>

    <template id="report_employee_file">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="emp" t-value="o.employee_id"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Employee file / ملف الموظف</h2>
                        <h3><t t-out="emp.employee_code or ''"/> <t t-out="emp.name"/></h3>
                        <table class="table table-sm" t-if="o.show_personal">
                            <tr><td>Birthday</td><td><t t-out="emp.birthday or ''"/></td></tr>
                            <tr><td>Phone</td><td><t t-out="emp.private_phone or ''"/> / <t t-out="emp.emergency_phone or ''"/></td></tr>
                            <tr><td>Email</td><td><t t-out="emp.private_email or emp.work_email or ''"/></td></tr>
                            <tr><td>Address</td><td><t t-out="emp.tarco_state_id.name or ''"/> / <t t-out="emp.tarco_city or ''"/> / <t t-out="emp.tarco_district or ''"/> / <t t-out="emp.tarco_square or ''"/></td></tr>
                            <tr><td>Qualification</td><td><t t-out="emp.certificate or ''"/></td></tr>
                            <tr><td>Marital status</td><td><t t-out="emp.marital or ''"/></td></tr>
                            <tr><td>Experience</td><td><t t-out="emp.tarco_experience_years"/></td></tr>
                            <tr><td>Religion</td><td><t t-out="emp.tarco_religion or ''"/></td></tr>
                            <tr><td>Nationality</td><td><t t-out="emp.country_id.name or ''"/></td></tr>
                            <tr><td>Gender</td><td><t t-out="emp.sex or ''"/></td></tr>
                        </table>
                        <table class="table table-sm" t-if="o.show_job">
                            <tr><td>Department</td><td><t t-out="emp.department_id.name or ''"/></td></tr>
                            <tr><td>Section</td><td><t t-out="emp.section_id.name or ''"/></td></tr>
                            <tr><td>Job</td><td><t t-out="emp.job_id.name or ''"/></td></tr>
                        </table>
                        <table class="table table-sm" t-if="o.show_contract">
                            <tr><td>Hire date</td><td><t t-out="emp.tarco_hire_date or ''"/></td></tr>
                            <tr><td>Probation end</td><td><t t-out="emp.tarco_trial_date_end or ''"/></td></tr>
                            <tr><td>Renewal</td><td><t t-out="emp.tarco_renewal_date or ''"/></td></tr>
                            <tr><td>Resignation</td><td><t t-out="emp.tarco_resignation_date or ''"/></td></tr>
                            <tr><td>Rehire</td><td><t t-out="emp.tarco_rehire_date or ''"/></td></tr>
                            <tr><td>Service</td><td><t t-out="emp.tarco_service_display or ''"/></td></tr>
                        </table>
                        <table class="table table-sm" t-if="o.show_salary">
                            <tr><td>Basic</td><td><t t-out="'%.2f' % (emp.tarco_basic_wage or 0.0)"/></td></tr>
                            <tr><td>Cost of living</td><td><t t-out="'%.2f' % (emp.tarco_cola or 0.0)"/></td></tr>
                            <tr><td>Transport</td><td><t t-out="'%.2f' % (emp.tarco_transport_allowance or 0.0)"/></td></tr>
                            <tr><td>Housing</td><td><t t-out="'%.2f' % (emp.tarco_housing_allowance or 0.0)"/></td></tr>
                            <tr><td>Other</td><td><t t-out="'%.2f' % (emp.tarco_other_allowance or 0.0)"/></td></tr>
                            <tr><td>Gross</td><td><t t-out="'%.2f' % (emp.tarco_gross_wage or 0.0)"/></td></tr>
                        </table>
                        <t t-if="o.show_documents">
                            <h4>Documents</h4>
                            <table class="table table-sm table-bordered">
                                <tr><th>Group</th><th>Kind</th><th>Received</th><th>Date</th></tr>
                                <tr t-foreach="emp.tarco_document_ids" t-as="doc">
                                    <td t-out="doc.group_type"/>
                                    <td t-out="doc.kind"/>
                                    <td t-out="doc.received"/>
                                    <td t-out="doc.document_date or ''"/>
                                </tr>
                            </table>
                        </t>
                        <p t-if="o.show_leave">Leave scheme <t t-out="emp.tarco_leave_scheme"/>: casual <t t-out="emp.tarco_casual_days"/>, annual <t t-out="emp.tarco_regular_days"/>.</p>
                        <p t-if="o.show_attendance">Shift <t t-out="emp.tarco_shift_id.name or ''"/>. Overtime mode <t t-out="emp.tarco_overtime_mode"/>.</p>
                        <p t-if="o.show_penalty">Penalties: <t t-out="emp.tarco_penalty_count"/></p>
                        <p t-if="o.show_reward">Rewards: <t t-out="emp.tarco_reward_count"/></p>
                        <p t-if="o.show_advance">Advances: <t t-out="emp.tarco_advance_count"/></p>
                        <p t-if="o.show_kpi">KPI reviews: <t t-out="emp.tarco_kpi_count"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_tarco_period">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Tarco HRIS</h2>
                        <p>
                            <t t-out="o.report_type"/>
                            — <t t-out="o.date_from"/> to <t t-out="o.date_to"/>
                        </p>
                        <div t-out="o.get_report_markup()"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
